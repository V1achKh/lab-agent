# Настройки проекта. Создаётся командой: cp .env.example .env
# Менять обычно нужно только блок «Титульный лист» внизу.

# --- Модели (llama.cpp: в отдельном терминале запущен scripts/llamacpp.sh gemma12 или qwen27)
LAB_LLM_URL=http://localhost:8080/v1
LAB_LLM_MODEL=gemma4-12b
LAB_EMBED_URL=http://localhost:8081/v1
LAB_EMBED_MODEL=bge-m3
# выключить «размышления» модели — без этого Gemma 4 и Qwen3.8 могут возвращать пустые ответы
LAB_LLM_EXTRA={"chat_template_kwargs": {"enable_thinking": false}}
# Для Qwen3.8-27B (scripts/llamacpp.sh qwen27) замените строку LAB_LLM_MODEL на:
# LAB_LLM_MODEL=qwen3.8-27b

# Если вместо llama.cpp используете Ollama — раскомментируйте (они перекроют строки выше):
# LAB_LLM_URL=http://localhost:11434/v1
# LAB_LLM_MODEL=qwen3:14b
# LAB_EMBED_URL=http://localhost:11434/v1

# --- Симуляция: auto | ngspice | builtin
LAB_SIM_ENGINE=auto
# сколько значащих цифр показывает прибор (как индикатор мультиметра в Multisim)
LAB_METER_DIGITS=4
# десятичный разделитель в отчёте, на схеме и графиках: . (21.25 В) или , (21,25 В)
LAB_DECIMAL=.

# --- Песочница для универсального режима: auto | podman | docker | bwrap
LAB_SANDBOX=auto
# lab-sandbox — свой образ (python -m labagent sandbox build) | host — без образа
LAB_SANDBOX_IMAGE=lab-sandbox
LAB_SANDBOX_TIMEOUT=60

# --- Оформление: bmstu (как в отчётах группы) | gost (ГОСТ 7.32)
LAB_REPORT_STYLE=bmstu
# подписи на схеме: bmstu («R₁ = 1 кОм», как в заданиях) | eskd
LAB_SCHEMATIC_LABELS=bmstu

# --- Титульный лист — ВПИШИТЕ СВОИ ДАННЫЕ
LAB_UNIVERSITY=МГТУ им. Н.Э. Баумана
LAB_DISCIPLINE=Электротехника
LAB_TEACHER=Белодедов М. В.
LAB_GROUP=ИУ5-34Б
LAB_STUDENT=Фамилия И. О.
# для стиля gost:
LAB_ORG=Министерство науки и высшего образования Российской Федерации\nМГТУ им. Н.Э. Баумана
LAB_DEPT=Кафедра ИУ5
LAB_CITY=Москва
